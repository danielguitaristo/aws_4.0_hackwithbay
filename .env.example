# Copy to .env.local and fill in. Never commit .env.local.
# Without any key, the demo estates are served from the committed cache (data/cache/).

# LLM (A + B)
MISTRAL_API_KEY=
# Model for every Mistral call (the committed caches were built with this one)
MISTRAL_MODEL=mistral-medium-latest

# Discovery + retrieval (A)
TAVILY_API_KEY=
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
# Max Tavily credits per live discovery run (0 = cache only, no live call)
TAVILY_RUN_BUDGET=40
# Live runs per hour for all visitors together, per route (/api/icp has its own counter)
LIVE_GLOBAL_MAX=20
# Live runs per visitor IP per 10 minutes, per route
LIVE_IP_MAX=10

# Graph, enrichment, billing (B)
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
HUNTER_API_KEY=
FLEXPRICE_API_KEY=
# Optional: Flexprice API host (leave empty for the default host)
FLEXPRICE_API_HOST=
STARTING_CREDITS=200

# Gmail (C) — Google Cloud OAuth client, type "Web application"
# Authorized redirect URI: http://localhost:3000/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth redirect URI (default: <site origin>/api/gmail/callback; set it to the Render URL in production)
GOOGLE_REDIRECT_URI=
# Safety net (required): EVERY letter goes to this test inbox instead of the importer.
# Without it, sending is locked. Only set GMAIL_ALLOW_REAL_SEND=true to email real importers on purpose.
GMAIL_DEMO_RECIPIENT=
GMAIL_ALLOW_REAL_SEND=
